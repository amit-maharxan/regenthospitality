{"translation-revision-date":"2026-11-06 10:50:15+0000","generator":"GlotPress\/4.1.0","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","plural-forms":"nplurals=2; plural=n != 1;","lang":"ne_NP"},"Empty file":["\u0916\u093e\u0932\u0940 \u092b\u093e\u0907\u0932"],"Upload failed":["\u0905\u092a\u0932\u094b\u0921 \u0905\u0938\u092b\u0932 \u092d\u092f\u094b"],"\"%s\" is empty.":["\"%s\" \u0916\u093e\u0932\u0940 \u091b\u0964"],"File too large":["\u092b\u093e\u0907\u0932 \u0927\u0947\u0930\u0948 \u0920\u0942\u0932\u094b \u091b"],"HEIC decode failed":["HEIC \u0905\u0938\u0919\u094d\u0915\u0947\u0924\u0928 \u0905\u0938\u092b\u0932 \u092d\u092f\u094b"],"Unsupported file type":["\u0905\u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u092b\u093e\u0907\u0932 \u092a\u094d\u0930\u0915\u093e\u0930"],"File type not allowed":["\u092b\u093e\u0907\u0932 \u092a\u094d\u0930\u0915\u093e\u0930 \u0905\u0928\u0941\u092e\u0924\u093f \u091b\u0948\u0928"],"Image rotation failed":["\u0924\u0938\u094d\u092c\u093f\u0930 \u0918\u0941\u092e\u093e\u0909\u0928 \u0905\u0938\u092b\u0932 \u092d\u092f\u094b"],"Failed to rotate \"%s\".":["\"%s\" \u0918\u0941\u092e\u093e\u0909\u0928 \u0905\u0938\u092b\u0932 \u092d\u092f\u094b\u0964"],"Failed to upload \"%s\".":["\"%s\" \u0905\u092a\u0932\u094b\u0921 \u0917\u0930\u094d\u0928 \u0905\u0938\u092b\u0932 \u092d\u092f\u094b\u0964"],"Image processing failed":["\u0924\u0938\u094d\u092c\u093f\u0930 \u092a\u094d\u0930\u0936\u094b\u0927\u0928 \u0905\u0938\u092b\u0932 \u092d\u092f\u094b"],"Failed to process \"%s\".":["\"%s\" \u092a\u094d\u0930\u0936\u094b\u0927\u0928 \u0917\u0930\u094d\u0928 \u0905\u0938\u092b\u0932 \u092d\u092f\u094b\u0964"],"Media processing failed":["\u092e\u093f\u0921\u093f\u092f\u093e \u092a\u094d\u0930\u0936\u094b\u0927\u0928 \u0905\u0938\u092b\u0932 \u092d\u092f\u094b"],"Could not finalize the upload.":["\u0905\u092a\u0932\u094b\u0921 \u0905\u0928\u094d\u0924\u093f\u092e \u0930\u0942\u092a \u0926\u093f\u0928 \u0938\u0915\u093f\u090f\u0928\u0964"],"Please choose a different file.":["\u0915\u0943\u092a\u092f\u093e \u092b\u0930\u0915 \u092b\u093e\u0907\u0932 \u091b\u093e\u0928\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964"],"Failed to decode HEIC file \"%s\".":["HEIC \u092b\u093e\u0907\u0932 \"%s\" \u0905\u0938\u0919\u094d\u0915\u0947\u0924\u0928 \u0917\u0930\u094d\u0928 \u0905\u0938\u092b\u0932 \u092d\u092f\u094b\u0964"],"\"%s\" is not a supported file type.":["\"%s\" \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u092b\u093e\u0907\u0932 \u092a\u094d\u0930\u0915\u093e\u0930 \u0939\u094b\u0907\u0928\u0964"],"You are not allowed to upload \"%s\".":["\u0924\u092a\u093e\u0908\u0901\u0932\u093e\u0908 \"%s\" \u0905\u092a\u0932\u094b\u0921 \u0917\u0930\u094d\u0928 \u0905\u0928\u0941\u092e\u0924\u093f \u091b\u0948\u0928\u0964"],"\"%s\" exceeds the maximum upload size.":["\"%s\" \u0905\u0927\u093f\u0915\u0924\u092e \u0905\u092a\u0932\u094b\u0921 \u0938\u093e\u0907\u091c\u092d\u0928\u094d\u0926\u093e \u092c\u0922\u0940 \u091b\u0964"],"Please upload a different file format.":["\u0915\u0943\u092a\u092f\u093e \u092b\u0930\u0915 \u092b\u093e\u0907\u0932 \u0922\u093e\u0901\u091a\u093e \u0905\u092a\u0932\u094b\u0921 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964"],"Could not finalize the upload of \"%s\".":["\"%s\" \u0915\u094b \u0905\u092a\u0932\u094b\u0921\u0932\u093e\u0908 \u0905\u0928\u094d\u0924\u093f\u092e \u0930\u0942\u092a \u0926\u093f\u0928 \u0938\u0915\u093f\u090f\u0928\u0964"],"Please reduce the file size and try again.":["\u0915\u0943\u092a\u092f\u093e \u092b\u093e\u0907\u0932 \u0938\u093e\u0907\u091c \u0918\u091f\u093e\u090f\u0930 \u092b\u0947\u0930\u093f \u092a\u094d\u0930\u092f\u093e\u0938 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964"],"Failed to convert \"%s\" to the target format.":["%s\" \u0932\u093e\u0908 \u0932\u0915\u094d\u0937\u093f\u0924 \u0922\u093e\u0901\u091a\u093e\u092e\u093e \u0930\u0942\u092a\u093e\u0928\u094d\u0924\u0930\u0923 \u0917\u0930\u094d\u0928 \u0905\u0938\u092b\u0932 \u092d\u092f\u094b\u0964"],"Please contact your site administrator.":["\u0915\u0943\u092a\u092f\u093e \u0906\u092b\u094d\u0928\u094b \u0938\u093e\u0907\u091f \u092a\u094d\u0930\u0936\u093e\u0938\u0915\u0932\u093e\u0908 \u0938\u092e\u094d\u092a\u0930\u094d\u0915 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964"],"The file may be corrupted. Try a different file.":["\u092b\u093e\u0907\u0932 \u092c\u093f\u0917\u094d\u0930\u093f\u090f\u0915\u094b \u0939\u0941\u0928 \u0938\u0915\u094d\u091b\u0964 \u092b\u0930\u0915 \u092b\u093e\u0907\u0932 \u092a\u094d\u0930\u092f\u093e\u0938 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964"],"The image may be corrupted. Try a different file.":["\u0924\u0938\u094d\u092c\u093f\u0930 \u092c\u093f\u0917\u094d\u0930\u093f\u090f\u0915\u094b \u0939\u0941\u0928 \u0938\u0915\u094d\u091b\u0964 \u092b\u0930\u0915 \u092b\u093e\u0907\u0932 \u092a\u094d\u0930\u092f\u093e\u0938 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964"],"%s couldn't decode HEIC on this Mac, so we couldn't convert this one.":["%s \u0932\u0947 \u092f\u094b Mac \u092e\u093e HEIC \u0905\u0938\u0919\u094d\u0915\u0947\u0924\u0928 \u0917\u0930\u094d\u0928 \u0938\u0915\u0947\u0928, \u0924\u094d\u092f\u0938\u0948\u0932\u0947 \u0939\u093e\u092e\u0940\u0932\u0947 \u092f\u0938\u0932\u093e\u0908 \u0930\u0942\u092a\u093e\u0928\u094d\u0924\u0930\u0923 \u0917\u0930\u094d\u0928 \u0938\u0915\u0947\u0928\u094c\u0901\u0964"],"This browser can't read HEIC photos, so we couldn't convert this one.":["\u092f\u094b \u092c\u094d\u0930\u093e\u0909\u091c\u0930\u0932\u0947 HEIC \u092b\u094b\u091f\u094b\u0939\u0930\u0942 \u092a\u0922\u094d\u0928 \u0938\u0915\u094d\u0926\u0948\u0928, \u0924\u094d\u092f\u0938\u0948\u0932\u0947 \u0939\u093e\u092e\u0940\u0932\u0947 \u092f\u0938\u0932\u093e\u0908 \u0930\u0942\u092a\u093e\u0928\u094d\u0924\u0930\u0923 \u0917\u0930\u094d\u0928 \u0938\u0915\u0947\u0928\u094c\u0901\u0964"],"%s couldn't decode HEIC on this device, so we couldn't convert this one.":["%s \u0932\u0947 \u092f\u0938 \u0921\u093f\u092d\u093e\u0907\u0938\u092e\u093e HEIC \u0905\u0938\u0919\u094d\u0915\u0947\u0924\u0928 \u0917\u0930\u094d\u0928 \u0938\u0915\u0947\u0928, \u0924\u094d\u092f\u0938\u0948\u0932\u0947 \u0939\u093e\u092e\u0940\u0932\u0947 \u092f\u0938\u0932\u093e\u0908 \u0930\u0942\u092a\u093e\u0928\u094d\u0924\u0930\u0923 \u0917\u0930\u094d\u0928 \u0938\u0915\u0947\u0928\u094c\u0901\u0964"],"%s couldn't decode HEIC on this PC, so we couldn't convert this one.":["%s \u0932\u0947 \u092f\u0938 PC \u092e\u093e HEIC \u0905\u0938\u0919\u094d\u0915\u0947\u0924\u0928 \u0917\u0930\u094d\u0928 \u0938\u0915\u0947\u0928, \u0924\u094d\u092f\u0938\u0948\u0932\u0947 \u0939\u093e\u092e\u0940\u0932\u0947 \u092f\u0938\u0932\u093e\u0908 \u0930\u0942\u092a\u093e\u0928\u094d\u0924\u0930\u0923 \u0917\u0930\u094d\u0928 \u0938\u0915\u0947\u0928\u094c\u0901\u0964"],"You can upload a JPEG instead.":["\u0924\u092a\u093e\u0908\u0901 \u092f\u0938\u0915\u094b \u0938\u091f\u094d\u091f\u093e JPEG \u0905\u092a\u0932\u094b\u0921 \u0917\u0930\u094d\u0928 \u0938\u0915\u094d\u0928\u0941\u0939\u0941\u0928\u094d\u091b\u0964"],"The image could not be uploaded.":["\u0924\u0938\u094d\u092c\u093f\u0930 \u0905\u092a\u0932\u094b\u0921 \u0917\u0930\u094d\u0928 \u0938\u0915\u093f\u090f\u0928\u0964"],"Chrome or Edge might, or you can upload a JPEG instead.":["Chrome \u0935\u093e Edge \u0932\u0947 \u0917\u0930\u094d\u0928 \u0938\u0915\u094d\u091b, \u0935\u093e \u0924\u092a\u093e\u0908\u0901 \u092f\u0938\u0915\u094b \u0938\u091f\u094d\u091f\u093e JPEG \u0905\u092a\u0932\u094b\u0921 \u0917\u0930\u094d\u0928 \u0938\u0915\u094d\u0928\u0941\u0939\u0941\u0928\u094d\u091b\u0964"],"Safari or Chrome usually can, or you can upload a JPEG instead.":["Safari \u0935\u093e Chrome \u0932\u0947 \u0938\u093e\u092e\u093e\u0928\u094d\u092f\u0924\u092f\u093e \u0938\u0915\u094d\u091b\u0928\u094d, \u0935\u093e \u0924\u092a\u093e\u0908\u0901\u0932\u0947 \u0938\u091f\u094d\u091f\u093e\u092e\u093e JPEG \u0905\u092a\u0932\u094b\u0921 \u0917\u0930\u094d\u0928 \u0938\u0915\u094d\u0928\u0941\u0939\u0941\u0928\u094d\u091b\u0964"],"Firefox can't read HEIC photos, so we couldn't convert this one.":["Firefox \u0932\u0947 HEIC \u0924\u0938\u094d\u092c\u093f\u0930\u0939\u0930\u0942 \u092a\u0922\u094d\u0928 \u0938\u0915\u094d\u0926\u0948\u0928, \u0924\u094d\u092f\u0938\u0948\u0932\u0947 \u0939\u093e\u092e\u0940\u0932\u0947 \u092f\u0938\u0932\u093e\u0908 \u0930\u0942\u092a\u093e\u0928\u094d\u0924\u0930\u0923 \u0917\u0930\u094d\u0928 \u0938\u0915\u0947\u0928\u094c\u0901\u0964"],"Safari usually can, or you can upload a JPEG instead.":["Safari \u0932\u0947 \u0938\u093e\u092e\u093e\u0928\u094d\u092f\u0924\u092f\u093e \u0938\u0915\u094d\u091b, \u0935\u093e \u092f\u0938\u0915\u094b \u0938\u091f\u094d\u091f\u093e JPEG \u0905\u092a\u0932\u094b\u0921 \u0917\u0930\u094d\u0928 \u0938\u0915\u094d\u0928\u0941\u0939\u0941\u0928\u094d\u091b\u0964"],"HEIC photos can't be decoded on Linux, so unfortunately we couldn't convert this one.":["Linux \u092e\u093e HEIC \u092b\u094b\u091f\u094b\u0939\u0930\u0942 \u0905\u0938\u0919\u094d\u0915\u0947\u0924\u0928 \u0917\u0930\u094d\u0928 \u0938\u0915\u093f\u0901\u0926\u0948\u0928, \u0924\u094d\u092f\u0938\u0948\u0932\u0947 \u0926\u0941\u0930\u094d\u092d\u093e\u0917\u094d\u092f\u0935\u0936 \u0939\u093e\u092e\u0940\u0932\u0947 \u092f\u094b \u092b\u094b\u091f\u094b \u0930\u0942\u092a\u093e\u0928\u094d\u0924\u0930\u0923 \u0917\u0930\u094d\u0928 \u0938\u0915\u0947\u0928\u094c\u0901\u0964"],"The web server cannot generate responsive image sizes for this image. Convert it to JPEG or PNG before uploading.":["\u0935\u0947\u092c \u0938\u0930\u094d\u092d\u0930\u0932\u0947 \u092f\u094b \u091b\u0935\u093f\u0915\u094b \u0932\u093e\u0917\u093f \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u0940 \u091b\u0935\u093f \u0906\u0915\u093e\u0930\u0939\u0930\u0942 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0917\u0930\u094d\u0928 \u0938\