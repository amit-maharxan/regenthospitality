0941\u0939\u094b\u0938\u094d"],"There was an error uninstalling the font family.":["\u092b\u0928\u094d\u091f \u092b\u0947\u092e\u093f\u0932\u0940 \u0905\u0928\u0907\u0928\u094d\u0938\u094d\u091f\u0932 \u0917\u0930\u094d\u0926\u093e \u0924\u094d\u0930\u0941\u091f\u093f \u092d\u092f\u094b\u0964"],"Uploaded fonts appear in your library and can be used in your theme. Supported formats: .ttf, .otf, .woff, and .woff2.":["\u0905\u092a\u0932\u094b\u0921 \u0917\u0930\u093f\u090f\u0915\u093e \u092b\u0928\u094d\u091f\u0939\u0930\u0942 \u0924\u092a\u093e\u0908\u0901\u0915\u094b \u0932\u093e\u0907\u092c\u094d\u0930\u0947\u0930\u0940\u092e\u093e \u0926\u0947\u0916\u093f\u0928\u094d\u091b\u0928\u094d \u0930 \u0924\u092a\u093e\u0908\u0901\u0915\u094b \u0925\u093f\u092e\u092e\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928 \u0938\u0915\u093f\u0928\u094d\u091b\u0964 \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0922\u093e\u0901\u091a\u093e\u0939\u0930\u0942: .ttf, .otf, .woff, \u0930 .woff2\u0964"],"%d variant":["%d \u092d\u0947\u0930\u093f\u092f\u0928\u094d\u091f","%d \u092d\u0947\u0930\u093f\u092f\u0928\u094d\u091f\u0939\u0930\u0942"],"Install Fonts":["\u092b\u0928\u094d\u091f \u0938\u094d\u0925\u093e\u092a\u0928\u093e"],"Font name\u2026":["\u092b\u0928\u094d\u091f \u0928\u093e\u092e\u2026"],"font style\u0004Normal":["\u0938\u093e\u092e\u093e\u0928\u094d\u092f"],"font weight\u0004Normal":["\u0938\u093e\u092e\u093e\u0928\u094d\u092f"],"Upload font":["\u092b\u0928\u094d\u091f \u0905\u092a\u0932\u094b\u0921"],"font weight\u0004Semi-bold":["\u0905\u0930\u094d\u0927-\u092c\u094b\u0932\u094d\u0921"],"font weight\u0004Extra-bold":["\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924-\u092c\u094b\u0932\u094d\u0921"],"font weight\u0004Extra-light":["\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924-\u0939\u0932\u0941\u0915\u094b"],"Fonts":["\u092b\u0928\u094d\u091f\u0939\u0930\u0942"],"Select font variants to install.":["\u0938\u094d\u0925\u093e\u092a\u0928\u093e \u0917\u0930\u094d\u0928 \u092b\u0928\u094d\u091f \u092d\u0947\u0930\u093f\u092f\u0928\u094d\u091f\u0939\u0930\u0942 \u091a\u092f\u0928 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964"],"Fonts were installed successfully.":["\u092b\u0928\u094d\u091f\u0939\u0930\u0942 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u094d\u0925\u093e\u092a\u0928\u093e \u0917\u0930\u093f\u092f\u094b\u0964"],"To install fonts from Google you must give permission to connect directly to Google servers. The fonts you install will be downloaded from Google and stored on your site. Your site will then use these locally-hosted fonts.":["\u0917\u0941\u0917\u0932\u092c\u093e\u091f \u092b\u0928\u094d\u091f\u0939\u0930\u0942 \u0938\u094d\u0925\u093e\u092a\u0928\u093e \u0917\u0930\u094d\u0928 \u0924\u092a\u093e\u0908\u0901\u0932\u0947 \u0917\u0941\u0917\u0932 \u0938\u0930\u094d\u092d\u0930\u0939\u0930\u0942\u092e\u093e \u0938\u0940\u0927\u093e \u091c\u0921\u093e\u0928 \u0917\u0930\u094d\u0928 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u093f\u0928\u0941 \u092a\u0930\u094d\u091b\u0964 \u0924\u092a\u093e\u0908\u0901\u0932\u0947 \u0938\u094d\u0925\u093e\u092a\u0928\u093e \u0917\u0930\u094d\u0928\u0941\u092d\u090f\u0915\u094b \u092b\u0928\u094d\u091f\u0939\u0930\u0942 \u0917\u0941\u0917\u0932\u092c\u093e\u091f \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0917\u0930\u0940 \u0924\u092a\u093e\u0908\u0901\u0915\u094b \u0938\u093e\u0907\u091f\u092e\u093e \u092d\u0923\u094d\u0921\u093e\u0930\u0923 \u0917\u0930\u093f\u0928\u0947\u091b\u0964 \u0924\u092a\u093e\u0908\u0901\u0915\u094b \u0938\u093e\u0907\u091f\u0932\u0947 \u0924\u094d\u092f\u0938\u092a\u091b\u093f \u092f\u0940 \u0938\u094d\u0925\u093e\u0928\u0940\u092f-\u0939\u094b\u0938\u094d\u091f \u0917\u0930\u093f\u090f\u0915\u093e \u092b\u0928\u094d\u091f\u0939\u0930\u0942 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928\u0947\u091b\u0964"],"Choose font variants. Keep in mind that too many variants could make your site slower.":["\u092b\u0928\u094d\u091f \u092d\u0947\u0930\u093f\u092f\u0928\u094d\u091f\u0939\u0930\u0942 \u091b\u093e\u0928\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964 \u0927\u094d\u092f\u093e\u0928 \u0930\u093e\u0916\u094d\u0928\u0941\u0939\u094b\u0938\u094d \u0915\u093f \u0927\u0947\u0930\u0948 \u092d\u0947\u0930\u093f\u092f\u0928\u094d\u091f\u0939\u0930\u0942\u0932\u0947 \u0924\u092a\u093e\u0908\u0901\u0915\u094b \u0938\u093e\u0907\u091f\u0932\u093e\u0908 \u0938\u0941\u0938\u094d\u0924 \u092c\u0928\u093e\u0909\u0928 \u0938\u0915\u094d\u091b\u0964"],"Font family uninstalled successfully.":["\u092b\u0928\u094d\u091f \u092b\u094d\u092f\u093e\u092e\u093f\u0932\u0940 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u094d\u0925\u093e\u092a\u0928\u093e \u0939\u091f\u093e\u0907\u092f\u094b\u0964"],"No fonts found. Try with a different search term.":["\u0915\u0941\u0928\u0948 \u092b\u0928\u094d\u091f \u092d\u0947\u091f\u093f\u090f\u0928\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u0930\u0915 \u0916\u094b\u091c \u091f\u0930\u094d\u092e \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964"],"Allow access to Google Fonts":["\u2018\u0917\u0941\u0917\u0932 \u092b\u0928\u094d\u091f\u0939\u0930\u0942\u2019 \u092e\u093e \u092a\u0939\u0941\u0901\u091a \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u093f\u0928\u0941\u0939\u094b\u0938\u094d"],"You can alternatively upload files directly on the Upload tab.":["\u0924\u092a\u093e\u0908\u0901 \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u0930\u0942\u092a\u092e\u093e \u2018\u0905\u092a\u0932\u094b\u0921\u2019 \u091f\u094d\u092f\u093e\u092c\u092e\u093e \u0938\u093f\u0927\u0948 \u092b\u093e\u0907\u0932\u0939\u0930\u0942 \u0905\u092a\u0932\u094b\u0921 \u0917\u0930\u094d\u0928 \u0938\u0915\u094d\u0928\u0941\u0939\u0941\u0928\u094d\u091b\u0964"],"Manage the fonts and typography used on captions.":["\